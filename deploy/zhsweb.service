[Unit]
Description=ZHS 多用户刷课站
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zhs
Group=zhs
WorkingDirectory=/opt/zhs

# 必填：会话签名 + 落库 cookie 加密的主密钥，换掉之后所有绑定失效
Environment=ZHS_SECRET=CHANGE_ME_TO_RANDOM_64_HEX
Environment=ZHS_DB=/opt/zhs/data/zhsweb.db
# 全站同时跑几个刷课任务（按出口带宽/风控自己调）
Environment=ZHS_MAX_CONCURRENT=3
# 单个用户同时几个任务
Environment=ZHS_MAX_TASKS_PER_USER=2

# 必须单 worker：任务注册表与二维码会话都在进程内存里。
# 多 worker 会出现"A 建的二维码 B 查不到"、"任务进度不更新"。
ExecStart=/opt/zhs/.venv/bin/gunicorn \
    -w 1 --threads 32 --timeout 0 \
    --access-logfile - --error-logfile - \
    -b 127.0.0.1:8778 webapp.app:app

Restart=always
RestartSec=3

# 基本加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/zhs/data

[Install]
WantedBy=multi-user.target